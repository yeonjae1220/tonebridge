# ──────────────────────────────────────────────────────────
# ToneBridge 환경변수 설정
# 이 파일을 복사하여 .env 파일을 만드세요:  cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요
# ──────────────────────────────────────────────────────────

# Google OAuth 2.0
# https://console.cloud.google.com/apis/credentials 에서 발급
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# JWT 서명 키 (최소 32자 이상의 랜덤 문자열)
# 생성: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-minimum-32-chars

# Claude API (https://console.anthropic.com)
CLAUDE_API_KEY=sk-ant-...

# OpenAI API (선택 - Whisper STT용)
OPENAI_API_KEY=sk-...
