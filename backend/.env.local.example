# ToneBridge 로컬 개발 환경변수 예시
# 복사 후 .env.local 로 이름 변경하여 사용 (git에 포함되지 않음)

# 데이터베이스 (H2 메모리 DB 기본 사용 — 필요 시 PostgreSQL로 변경)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tonebridge
# SPRING_DATASOURCE_USERNAME=tonebridge
# SPRING_DATASOURCE_PASSWORD=tonebridge

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT (로컬 개발용 — 최소 32자 이상)
JWT_SECRET=local-dev-secret-key-change-this-in-production-must-be-long

# Storage (MinIO 로컬 개발용)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tonebridge-audio

# Admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD_BCRYPT=$2a$10$UgCnMxTvac2Sqpnc7zhoHebP9kdxkI6rwA0fo/TPUIL6Tje0ZB6HO

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
